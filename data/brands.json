          "series": "Team"
        },
        {
          "match": "Perf Series",
          "series": "Perf"
        }
      ],
      "programs": {
        "freeride": "Freeride",
        "freefly": "Freefly",
        "freestyle": "Freestyle",
        "wave": "Wave ?riding|Waveriding",
        "lightwind": "Light ?wind|Lightwind",
        "race": "Racing",
        "multisport": "Multisports"
